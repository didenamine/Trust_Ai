# Copy this file to .env and adjust the values. Never commit .env.

# --- PostgreSQL ---
POSTGRES_USER=trustai
POSTGRES_PASSWORD=trustai
POSTGRES_DB=trustai
POSTGRES_PORT=5432

# --- Backend (FastAPI) ---
ENVIRONMENT=development
# Used when running the API outside Docker. Docker Compose overrides it to point at the `db` service.
DATABASE_URL=postgresql+psycopg://trustai:trustai@localhost:5432/trustai
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# JWT (US01)
JWT_SECRET=change-me
JWT_EXPIRES_MINUTES=60

# LLM API (US05 / US09)
LLM_API_KEY=

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:8000/api
