# Copy this file to .env and adjust the values. Never commit .env.

# --- PostgreSQL ---
POSTGRES_USER=trustai
POSTGRES_PASSWORD=change-me
POSTGRES_DB=trustai
POSTGRES_PORT=5432

# --- Backend (FastAPI) ---
ENVIRONMENT=development
# Host the API uses to reach PostgreSQL when running outside Docker (Docker Compose sets it to `db`).
POSTGRES_HOST=localhost
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# JWT (US01)
JWT_SECRET=change-me
JWT_EXPIRES_MINUTES=60
PASSWORD_RESET_EXPIRES_MINUTES=15

# LLM API (US05 / US09 / US14): Groq, key from https://console.groq.com/keys
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# Optional: answer size limit and reasoning effort (leave empty for models without reasoning)
# LLM_MAX_COMPLETION_TOKENS=8192
# LLM_REASONING_EFFORT=low

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:8000/api
